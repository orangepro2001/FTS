{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fts-updater",
  "version": "0.1.0",
  "identifier": "com.fts.updater",
  "build": {
    "frontendDist": "../webdist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "fts 更新器",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
